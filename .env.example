# Buzón de Sugerencias y Reclamos — variables de entorno requeridas.
# Copiar como .env.local para desarrollo (nunca commitear valores reales)
# y cargar las mismas en Vercel → Project Settings → Environment Variables.

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com → API Keys)
RESEND_API_KEY=
RESEND_FROM=Buzon Union Agronomia <onboarding@resend.dev>

# Hasta 3 correos separados por coma
BUZON_EMAILS=correo1@ejemplo.com,correo2@ejemplo.com,correo3@ejemplo.com

# --- Contador de visitas (usa las mismas credenciales de Supabase de arriba) ---
# Clave simple para acceder a /admin-visitas — no es un sistema de autenticación,
# solo un valor secreto comparado del lado del servidor (api/visitas.js).
VISITAS_ADMIN_KEY=
